# Application
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Opt-in: on boot, delete every user except the seeded CEO (ceo@gmail.com).
# Use once to clear leftover invite/test accounts, then set false or remove.
SEED_CEO_ONLY=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database — use postgres with Docker (default below) or sqlite for zero-deps
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=techos
DATABASE_PASSWORD=techos
DATABASE_NAME=techos
DATABASE_SYNC=true
# DATABASE_TYPE=sqlite
# DATABASE_PATH=./techos.db

# Redis (docker compose service — mapped to host 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_ENABLED=true

# Local SMTP via Mailhog (docker) — UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@techos.local

# Resend (optional production email; leave empty to use SMTP/Mailhog)
RESEND_API_KEY=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# AI Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# Code review PR import (optional; Integrations GitHub/GitLab tokens also work)
GITHUB_TOKEN=
GITLAB_TOKEN=

# Optional MinIO (docker compose --profile storage)
MINIO_ROOT_USER=techos
MINIO_ROOT_PASSWORD=techossecret
